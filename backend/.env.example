NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Local PostgreSQL / pgAdmin connection. URL-encode special characters in passwords.
DATABASE_URL=postgresql://postgres:replace-with-your-password@localhost:5432/readrise?sslmode=disable

# Replace with a long, random secret before running the API.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google OAuth (optional, for Google Sign-in)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Chapa Payment Integration (optional, for premium book purchases)
CHAPA_PUBLIC_KEY=CHAPA_TEST_PUB_xxxxxx
CHAPA_SECRET_KEY=CHAPA_TEST_PRIV_xxxxxx
